 */

model SupportTicket {
  id Int @id @default(autoincrement())

  userId          Int
  assignedAgentId Int?

  subject     String
  description String @default("")

  category String @default("TECHNICAL")
  status   String @default("OPEN")
  priority String @default("NORMAL")
  channel  String @default("WEB")

  relatedEntityType String @default("")
  relatedEntityId   String @default("")

  unreadMessages Int @default(0)

  firstResponseAt DateTime?
  lastMessageAt   DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user          User  @relation("SupportTicketRequester", fields: [userId], references: [id], onDelete: Restrict)
  assignedAgent User? @relation("SupportTicketAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)

  messages SupportMessage[]

  @@index([userId, createdAt])
  @@index([assignedAgentId, status])
  @@index([status, priority])
  @@index([category, status])
  @@index([relatedEntityType, relatedEntityId])
  @@index([updatedAt])
}

model SupportMessage {
  id Int @id @default(autoincrement())

  ticketId Int
  authorId Int?

  authorName String @default("")
  authorRole String @default("USER")

  message    String
  isInternal Boolean @default(false)

  readAt    DateTime?
  createdAt DateTime  @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?         @relation("SupportMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@index([authorId, createdAt])
}

model AuditLog {
  id Int @id @default(autoincrement())

  actorId   Int?
  actorName String @default("")
  actorRole String @default("")

  module      String @default("SYSTEM")
  action      String
  description String

  entityType String @default("SYSTEM")
  entityId   String @default("")

  method   String @default("")
  endpoint String @default("")

  ipAddress  String @default("")
  deviceInfo String @default("")
  requestId  String @default("")

  severity String @default("LOW")
  status   String @default("SUCCESS")

  before   Json?
  after    Json?
  metadata Json  @default("{}")

  reviewStatus String    @default("NOT_REQUIRED")
  reviewedAt   DateTime?
  reviewedById Int?

  integrityHash String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  actor User? @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([module, action])
  @@index([severity, status])
  @@index([entityType, entityId])
  @@index([reviewStatus, createdAt])
  @@index([createdAt])
}

model SecurityAlert {
  id Int @id @default(autoincrement())

  userId Int

  type      String
  riskLevel String @default("MEDIUM")
  message   String

  ipAddress  String @default("")
  deviceInfo String @default("")

  status          String    @default("OPEN")
  assignedToId    Int?
  resolutionNotes String    @default("")
  resolvedAt      DateTime?
  resolvedById    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, riskLevel])
  @@index([type])
}

model SessionLog {
  id Int @id @default(autoincrement())

  userId Int

  ipAddress  String @default("")
  deviceInfo String @default("")

  browser         String @default("")
  operatingSystem String @default("")
  country         String @default("")
  city            String @default("")

  loginStatus String @default("SUCCESS")
  riskLevel   String @default("LOW")
  notes       String @default("")

  isActive      Boolean @default(true)
  trustedDevice Boolean @default(false)
  blockedDevice Boolean @default(false)

  startedAt      DateTime  @default(now())
  lastActivityAt DateTime  @default(now())
  endedAt        DateTime?
  endedById      Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([loginStatus, riskLevel])
  @@index([ipAddress])
  @@index([startedAt])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

/**
 * |--------------------------------------------------------------------------
 * | Messenger QSM
 * |--------------------------------------------------------------------------
 */

model Conversation {
  id            Int     @id @default(autoincrement())
  legacyMongoId String?

  productId Int?
  orderId   Int?

  lastMessageText     String    @default("")
  lastMessageSenderId Int?
  lastMessageAt       DateTime?

  language           String  @default("es")
  translationEnabled Boolean @default(false)
  exportCount        Int     @default(0)

  category String @default("GENERAL")
  priority String @default("NORMAL")
  status   String @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  product           Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  order             Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  lastMessageSender User?    @relation("ConversationLastMessageSender", fields: [lastMessageSenderId], references: [id], onDelete: SetNull)

  participants     ConversationParticipant[]
  messages         Message[]
  labelAssignments ConversationLabelAssignment[]
  pinnedMessages   ConversationPinnedMessage[]

  @@index([productId, updatedAt])
  @@index([orderId, updatedAt])
  @@index([status, updatedAt])
  @@index([category, priority])
}

model ConversationParticipant {
  id             Int @id @default(autoincrement())
  conversationId Int
  userId         Int

  unreadCount Int @default(0)

  muted    Boolean @default(false)
  archived Boolean @default(false)
  blocked  Boolean @default(false)
  favorite Boolean @default(false)
  pinned   Boolean @default(false)

  pinnedOrder Int?
  joinedAt    DateTime  @default(now())
  lastReadAt  DateTime?
  updatedAt   DateTime  @default(now()) @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, archived, updatedAt(sort: Desc)])
  @@index([userId, favorite])
  @@index([userId, pinned, pinnedOrder])
}

model Message {
  id            Int     @id @default(autoincrement())
  legacyMongoId String? @unique

  conversationId Int
  orderId        Int?
  senderId       Int
  receiverId     Int
  productId      Int?
  replyToId      Int?

  messageType String @default("TEXT")
  content     String @default("")
  text        String @default("")

  attachments Json @default("[]")
  reactions   Json @default("[]")
  location    Json @default("{}")

  voiceDuration Float @default(0)

  isFlagged       Boolean  @default(false)
  riskLevel       String   @default("LOW")
  aiReason        String   @default("")
  securityScore   Int      @default(0)
  securityReasons String[] @default([])

  isEdited Boolean   @default(false)
  editedAt DateTime?

  deletedForEveryone Boolean   @default(false)
  deletedAt          DateTime?

  status      String    @default("SENT")
  deliveredAt DateTime?
  readAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  order        Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id])
  receiver     User         @relation("MessageReceiver", fields: [receiverId], references: [id])
  product      Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)

  replyTo Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies Message[] @relation("MessageReplies")

  pins ConversationPinnedMessage[]

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
  @@index([receiverId, readAt])
  @@index([orderId])
  @@index([productId])
  @@index([status, createdAt])
  @@index([isFlagged, riskLevel])
}

model ConversationLabel {
  id            Int     @id @default(autoincrement())
  legacyMongoId String? @unique

  name  String
  slug  String
  color String @default("#8b5cf6")
  icon  String @default("tag")

  isSystem Boolean @default(false)
  ownerId  Int?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  owner       User?                         @relation("ConversationLabelOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  assignments ConversationLabelAssignment[]

  @@unique([slug, ownerId])
  @@index([ownerId, isActive])
  @@index([isSystem, isActive])
}

model ConversationLabelAssignment {
  id             Int      @id @default(autoincrement())
  conversationId Int
  labelId        Int
  assignedById   Int
  assignedAt     DateTime @default(now())

  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  label        ConversationLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)
  assignedBy   User              @relation("ConversationLabelAssignedBy", fields: [assignedById], references: [id], onDelete: Cascade)

  @@unique([conversationId, labelId, assignedById])
  @@index([labelId])
  @@index([assignedById])
}

model ConversationPinnedMessage {
  id             Int      @id @default(autoincrement())
  conversationId Int
  messageId      Int
  pinnedById     Int
  pinnedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  pinnedBy     User         @relation("ConversationPinnedBy", fields: [pinnedById], references: [id], onDelete: Cascade)

  @@unique([conversationId, messageId, pinnedById])
  @@index([messageId])
  @@index([pinnedById])
}

model UserSetting {
  id     Int @id @default(autoincrement())
  userId Int @unique

  data Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
}

model SystemSetting {
  id  Int    @id @default(autoincrement())
  key String @unique @default("GLOBAL_SYSTEM_SETTINGS")

  data Json @default("{}")

  updatedById   Int?
  lastResetById Int?
  lastResetAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([updatedAt])
}

model VehicleReport {
  id       Int @id @default(autoincrement())
  sellerId Int

  vin   String
  plate String @default("")
  brand String @default("")
  model String @default("")
  year  Int?

  carfaxStatus String @default("PENDING")

  accidentReported Boolean @default(false)
  salvageTitle     Boolean @default(false)
  ownersCount      Int     @default(0)
  mileageStatus    String  @default("UNKNOWN")

  vehicleScore Int    @default(70)
  riskLevel    String @default("LOW")

  reportSummary String @default("")
  rawCarfaxData Json   @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  seller User @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId, createdAt])
  @@index([vin])
  @@index([riskLevel, createdAt])
}

model Shipping {
  id              Int       @id @default(autoincrement())
  orderId         Int       @unique
  buyerId         Int
  sellerId        Int
  productId       Int
  trackingCode    String    @unique
  carrier         String    @default("QSM Delivery")
  status          String    @default("PENDING")
  originAddress   String    @default("")
  deliveryAddress String
  deliveryNotes   String    @default("")
  deliveredAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  buyer           User      @relation("ShippingBuyer", fields: [buyerId], references: [id])
  seller          User      @relation("ShippingSeller", fields: [sellerId], references: [id])
  product         Product   @relation(fields: [productId], references: [id])

  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([status, createdAt])
}
